-- The administrator password as a PBKDF2 hash, a single row. salt and hash are Base64.
CREATE TABLE admin_password (
    id INTEGER PRIMARY KEY CHECK (id = 1),
    salt TEXT NOT NULL,
    hash TEXT NOT NULL,
    iterations INTEGER NOT NULL
);

select:
SELECT salt, hash, iterations FROM admin_password WHERE id = 1;

-- Only into an empty table: a stored password is never replaced by a seed.
seed:
INSERT OR IGNORE INTO admin_password(id, salt, hash, iterations) VALUES (1, :salt, :hash, :iterations);

replace:
INSERT OR REPLACE INTO admin_password(id, salt, hash, iterations) VALUES (1, :salt, :hash, :iterations);
